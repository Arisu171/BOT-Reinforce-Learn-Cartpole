# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and configuration files
*.py text eol=lf diff=python
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf

# Binary files (prevent line ending conversion and diff corruption)
*.pt binary
*.pth binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.pdf binary
*.pptx binary

